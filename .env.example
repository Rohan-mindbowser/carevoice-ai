# ─────────────────────────────────────────────────────────────
# CareVoice AI — environment template
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# Config is validated by Zod at startup (apps/api/src/config/env.ts);
# the API fails fast if a required var is missing or malformed.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# CORS — comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:5173

# ── FHIR backend ──────────────────────────────────────────────
# cerner = live Cerner/Oracle Health FHIR R4.
FHIR_SOURCE=cerner
FHIR_TIMEOUT_MS=5000

# ── Gemini (Google GenAI) — wired live (Phase 6) ──────────────
GOOGLE_GENAI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ── Pinecone (RAG) — wired live (Phase 7) ─────────────────────
PINECONE_API_KEY=
PINECONE_INDEX=
# EMBEDDING_DIM must equal the Pinecone index dimension. gemini-embedding-001 supports 768/1024/
# 1536/3072 via Matryoshka truncation; set EMBEDDING_DIM to match your index (this project uses 1024).
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1024

# ── Cerner FHIR sandbox ───────────────────────────────────────
# Leave CERNER_BASE_URL blank to use the public OPEN sandbox (no auth required).
# For the SECURE endpoint, set the fhir-ehr URL + client creds (SMART, wired in Phase 12).
# https://fhir-ehr.cerner.com/r4/ec2458f2-1e24-41c8-b71b-0e701af7583d
CERNER_BASE_URL=
CERNER_CLIENT_ID=
CERNER_CLIENT_SECRET=
CERNER_SCOPE=

# ── Auth / OAuth2 / SMART on FHIR (Phase 12) ──────────────────
OAUTH_ISSUER=
OAUTH_AUDIENCE=
OAUTH_JWKS_URI=
